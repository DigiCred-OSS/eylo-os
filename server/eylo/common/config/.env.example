# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
AUTH_SECRET_KEY=                       # Required. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=                        # Required. Exactly 64 hex characters: openssl rand -hex 32
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ALGORITHM=HS256

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DB_USER=eylo
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=eylo

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# Voice — STT/TTS
# ─────────────────────────────────────────────
# Configure STT/TTS providers through authenticated API endpoints:
#   POST /api/stt-configs  (deepgram, deepgram-flux, sarvam, etc.)
#   POST /api/tts-configs  (cartesia, elevenlabs, sarvam, openai, groq, etc.)

# ─────────────────────────────────────────────
# WebRTC — TURN/STUN
# ─────────────────────────────────────────────
# Configure WebRTC/TURN providers through authenticated API endpoints:
#   POST /api/webrtc-configs  (metered, turnix)

# ─────────────────────────────────────────────
# Telephony
# ─────────────────────────────────────────────
# Telephony provider credentials are org-scoped via the existing
# per-org telephony provider config API (modules/telephony/).
# Optional trusted deployment override for a Twilio-compatible egress gateway.
# Leave blank to use Twilio's fixed hosted API endpoint.
TWILIO_API_BASE_URL=

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────
# Configure email providers through authenticated API endpoints:
#   POST /api/email-configs  (smtp, sendgrid)

# Exact comma-separated OpenAI-compatible embedding base URLs trusted by the
# deployment. Leave blank to allow only OpenAI's fixed hosted API endpoint.
EMBEDDING_BASE_URL_ALLOWLIST=

# Exact comma-separated Cohere-compatible rerank endpoints trusted by the
# deployment. Leave blank to allow only Cohere and Voyage hosted endpoints.
RERANKING_BASE_URL_ALLOWLIST=

# ─────────────────────────────────────────────
# Filesystem storage (optional trusted mount)
# ─────────────────────────────────────────────
# Required only when an org selects the filesystem storage adapter. The API
# selects a namespace below this operator-owned root; it cannot select a host path.
STORAGE_FILESYSTEM_ROOT=

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
SERVER_DOMAIN=              # e.g. api.yourdomain.com (used for telephony webhook URLs)
API_BASE_URL=               # e.g. https://api.yourdomain.com/api
OAUTH_CALLBACK_URL=         # e.g. https://api.yourdomain.com/api/oauth/callback
FRONTEND_URL=               # e.g. https://console.yourdomain.com
WIDGET_URL=                 # e.g. https://chat.yourdomain.com
# Local-only standalone widget QA. Both UUIDs must identify an existing contact
# in the same organization. Never configure these outside ENV=local.
WIDGET_DEVELOPMENT_ORGANIZATION_ID=
WIDGET_DEVELOPMENT_CONTACT_ID=

# ─────────────────────────────────────────────
# CORS (JSON array of allowed origins; defaults to localhost)
# ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ─────────────────────────────────────────────
# Agent Loop Configuration
# ─────────────────────────────────────────────
ENABLE_WORKERS=true
ENABLE_SPAWN_TASK_FNF=false
